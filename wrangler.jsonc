{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bento",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bento",
      // `npm run db:create` の出力を貼る
      "database_id": "7fa7c0fe-282e-4d85-afaf-1fba0b292e00",
      "migrations_dir": "migrations"
    }
  ]
}
