{
  "name": "bento",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test test/*.test.mjs",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create bento",
    "db:new": "wrangler d1 migrations create bento",
    "db:apply": "wrangler d1 migrations apply bento --local",
    "db:apply:remote": "wrangler d1 migrations apply bento --remote",
    "db:console": "wrangler d1 execute bento --local --command",
    "check": "biome check src test scripts biome.json package.json tsconfig.json wrangler.jsonc",
    "check:fix": "biome check --write src test scripts biome.json package.json tsconfig.json wrangler.jsonc",
    "types": "wrangler types",
    "postinstall": "wrangler types",
    "discord:register": "node scripts/register-commands.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
